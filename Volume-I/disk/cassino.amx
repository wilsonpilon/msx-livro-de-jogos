10 'Converted with Basic Dignified
20 'https://github.com/farique1/basic-dignified
30 rem -- CASSINO
40 screen 0
50 width 40
60 key off
70 color 11,1,1
80 zz=rnd(-time)
90 for zy=1 to zz
100 zx=rnd(1)
110 next
120 rem -- Graficos internacionais: prefixo chr$(1), codigos 86 a 91.
130 zw$=chr$(1)+chr$(86)
140 zv$=chr$(1)+chr$(87)
150 zu$=chr$(1)+chr$(88)
160 zt$=chr$(1)+chr$(89)
170 zs$=chr$(1)+chr$(90)
180 zr$=chr$(1)+chr$(91)
190 zq$=""
200 for zy=1 to 36
210 zq$=zq$+zv$
220 next
230 zp$=zu$
240 zo$=zs$
250 for zy=1 to 5
260 zp$=zp$+zv$
270 zo$=zo$+zv$
280 next
290 zp$=zp$+zt$
300 zo$=zo$+zr$
310 gosub 1330
320 locate 8,5
330 print "A sorte esta nos numeros!"
340 locate 4,7
350 print "Escolha o saldo e faca sua aposta."
360 locate 4,9
370 print "Tres iguais: ganhe 50 x a aposta."
380 locate 4,11
390 print "Tres setes: ganhe 500 x a aposta!"
400 locate 4,13
410 print "Outros numeros: perde a aposta."
420 locate 4,15
430 print "Aposte zero para sair do jogo."
440 locate 4,18
450 print "Pressione uma tecla para comecar"
460 play "t180o5v10l8cego6c4","t180o3v7l4cge2"
470 zn$=input$(1)
480 color 15,1,1
490 gosub 1330
500 locate 4,8
510 input "Quantia inicial :";zm
520 color 10,1,1
530 gosub 1330
540 for zy=1 to 3
550 zl=6+(zy-1)*10
560 locate zl,7
570 print zp$;
580 locate zl,8
590 print zw$;"     ";zw$;
600 locate zl,9
610 print zo$;
620 next zy
630 locate 4,11
640 print "Saldo :";zm
650 locate 4,18
660 print "Aposte zero para encerrar"
670 locate 4,13
680 input "Sua aposta :";zk
690 if zk=0 or zk>zm then 1220
700 color 11,1,1
710 locate 4,16
720 print "Girando...";
730 zl=9
740 gosub 1140
750 zj=zi
760 zl=19
770 gosub 1140
780 zh=zi
790 zl=29
800 gosub 1140
810 if zj=zh and zj=zi then 1030
820 zg=-zk
830 zf$="Nao foi desta vez. Tente de novo!"
840 color 8,1,1
850 play "t160o4v9l8gec4","t160o3v6l4cr4"
860 zm=zm+zg
870 locate 4,13
880 print space$(32);
890 locate 4,13
900 print "Aposta :";zk
910 locate 4,14
920 print "Resultado :";zg
930 locate 4,16
940 print zf$;
950 locate 4,18
960 print space$(32);
970 locate 4,18
980 print "Saldo atualizado :";zm
990 locate 4,20
1000 print "Pressione uma tecla"
1010 zn$=input$(1)
1020 goto 520
1030 zg=zk*50
1040 zf$="Tres iguais! Voce ganhou!"
1050 color 3,1,1
1060 if zj=7 then 1090
1070 play "t200o5v12l8cego6c4","t200o4v8l4ceg2","t200o3v6l4cgr2"
1080 goto 860
1090 zg=zk*500
1100 zf$="Sete, sete, sete! Premio maximo!"
1110 color 10,4,4
1120 play "t220o5v13l16cego6cego5c4","t220o4v9l8cego5c4","t220o3v8l8cgcg4"
1130 goto 860
1140 for ze=1 to 8
1150 zi=int(rnd(1)*9+1)
1160 locate zl,8
1170 print chr$(48+zi);
1180 play "t255o5v8l64c"
1190 next ze
1200 play "t255o6v10l32g"
1210 return
1220 color 11,1,1
1230 gosub 1330
1240 locate 8,7
1250 print "Obrigado por jogar!"
1260 locate 4,10
1270 print "Voce tem :";zm
1280 locate 8,14
1290 print "Ate a proxima rodada!"
1300 play "t160o5v10l8gec4","t160o3v7l4gc2"
1310 key on
1320 end
1330 cls
1340 locate 1,1
1350 print zu$;zq$;zt$;
1360 for zd=2 to 21
1370 locate 1,zd
1380 print zw$;
1390 locate 38,zd
1400 print zw$;
1410 next zd
1420 locate 1,22
1430 print zs$;zq$;zr$;
1440 locate 14,3
1450 print "Cassino MSX";
1460 return
