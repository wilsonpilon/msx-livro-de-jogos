750 return
760 pm=0
770 jp=0
780 mp$="Sem premio. Tente de novo!"
790 zn=0
800 zm=0
810 zl=0
820 zk=1
830 zj=0
840 zi=1
850 for zh=1 to 3
860 if zh=1 then zg=ra else if zh=2 then zg=rb else zg=rc
870 if zg<>int(zg)or zg<1 or zg>9 then error 5
880 if zg=1 then zn=zn+1
890 if zg=7 then zl=zl+1
900 if zg=9 then zm=zm+1
910 if(zg<4 or zg>6)and zg<>9 then zk=0
920 if zg<>9 and zj=0 then zj=zg
930 if zg<>9 and zg<>zj then zi=0
940 next zh
950 if zl=3 then pm=40:jp=1:mp$="Tres setes! Premio maximo!":return
960 if zm=3 then pm=10:mp$="Tres naves!":return
970 if zl=2 and zm=1 then pm=10:mp$="Dois setes e uma nave!":return
980 if zi=0 then 1030
990 pm=3
1000 mp$="Tres iguais!"
1010 if zj=1 then pm=10:mp$="Tres cerejas!"
1020 if zm>0 then pm=pm*2:mp$="Trinca com curinga!"
1030 if zk and pm<2 then pm=2:mp$="Joias misturadas!"
1040 if zn=2 and pm<3 then pm=3:mp$="Duas cerejas!"
1050 if zn=3 and pm<10 then pm=10:mp$="Tres cerejas!"
1060 if ra=1 and pm<1 then pm=1:mp$="Cereja: aposta devolvida!"
1070 return
