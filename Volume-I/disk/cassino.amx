30 rem -- CASSINO
40 dim zz(3),zy(3)
50 goto 1080
60 em=1
70 goto 90
80 em=0
90 if ec<>int(ec)or el<>int(el)or et<>int(et)then error 5
100 if ec<0 or el<0 or el>23 or et<1 then error 5
110 if ec+et>=peek(&hf3b0)then error 5
120 if em and et>14 then error 5
130 es$=""
140 zx=0
150 zw=0
160 locate ec,el,0
170 print es$;space$(et-len(es$));
180 gosub 420
190 zv$=inkey$
200 if zv$="" then 190
210 zu=asc(zv$)
220 if zu=13 then 630
230 if zu=29 then 370
240 if zu=28 then 390
250 if zu=18 then zw=1-zw:goto 190
260 if zu=8 then 460
270 if zu=127 then 480
280 if zu<32 then 190
290 if em and zv$="," then zv$="."
300 zt$=left$(es$,zx)+zv$
310 if zw then zt$=zt$+mid$(es$,zx+1)else zt$=zt$+mid$(es$,zx+2)
320 if len(zt$)>et then beep:goto 190
330 if em then gosub 510:if zs=0 then beep:goto 190
340 es$=zt$
350 if zx<et then zx=zx+1
360 goto 160
370 if zx>0 then zx=zx-1
380 goto 400
390 if zx<len(es$)then zx=zx+1
400 gosub 420
410 goto 190
420 zr=zx
430 if zr=et then zr=et-1
440 locate ec+zr,el,1
450 return
460 if zx=0 then 190
470 zx=zx-1
480 if zx>=len(es$)then 190
490 es$=left$(es$,zx)+mid$(es$,zx+2)
500 goto 160
510 zs=0
520 zq=0
530 for zp=1 to len(zt$)
540 zo$=mid$(zt$,zp,1)
550 if zo$>="0" and zo$<="9" then 600
560 if zp=1 and(zo$="+" or zo$="-")then 600
570 if zo$<>"." then return
580 zq=zq+1
590 if zq>1 then return
600 next zp
610 zs=1
620 return
630 if em=0 then 730
640 zt$=es$
650 gosub 510
660 if zs=0 then beep:goto 190
670 for zp=1 to len(es$)
680 zo$=mid$(es$,zp,1)
690 if zo$>="0" and zo$<="9" then 730
700 next zp
710 beep
720 goto 190
730 locate ec+zr,el,0
