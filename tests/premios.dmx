dim contagem(40)
goto {iniciar_teste}

{avaliar_combinacao}
    include "..\include\premios.dmx"

{iniciar_teste}
screen 0
width 40
key off
restore {casos}
for teste = 1 to 25
    read ra, rb, rc, esperado, jackpot_esperado
    gosub {avaliar_combinacao}
    if pm <> esperado or jp <> jackpot_esperado then print "FALHOU: caso"; teste; ra; rb; rc; pm; jp: end
next teste
soma_premios = 0
for ra = 1 to 9
    for rb = 1 to 9
        for rc = 1 to 9
            gosub {avaliar_combinacao}
            contagem(pm) = contagem(pm) + 1
            soma_premios = soma_premios + pm
        next rc
    next rb
next ra
if soma_premios <> 672 then print "FALHOU: soma"; soma_premios: end
restore {frequencias}
for teste = 1 to 8
    read multiplicador, esperado
    if contagem(multiplicador) <> esperado then print "FALHOU: frequencia"; multiplicador; contagem(multiplicador): end
next teste
print "TODOS OS PREMIOS PASSARAM"
end

{casos}
data 1,2,3,1,0, 2,1,3,0,0, 1,1,2,3,0, 2,1,1,3,0, 1,1,1,10,0
data 2,2,2,3,0, 3,3,3,3,0, 4,5,6,2,0, 4,4,5,2,0, 4,5,9,2,0
data 9,4,5,2,0, 4,4,4,3,0, 1,1,9,20,0, 1,9,9,20,0, 2,2,9,6,0
data 9,2,2,6,0, 2,9,9,6,0, 7,7,7,40,1, 7,7,9,10,0, 9,7,7,10,0
data 7,9,9,6,0, 9,9,9,10,0, 1,2,9,1,0, 2,9,1,0,0, 8,9,8,6,0

{frequencias}
data 0,546, 1,63, 2,42, 3,27, 6,39, 10,5, 20,6, 40,1
