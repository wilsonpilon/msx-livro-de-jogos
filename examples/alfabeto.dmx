rem -- Alfabeto Graphos III: editar os DATA e executar para salvar o BIN.
screen 1
width 32
key off
color 15, 4, 4
cls
restore {dados_alfabeto}
for codigo_alfabeto = 0 to 255
    read caractere_alfabeto$
    if len(caractere_alfabeto$) <> 71 then error 5
    for linha_alfabeto = 0 to 7
        bits_alfabeto$ = mid$(caractere_alfabeto$, linha_alfabeto * 9 + 1, 8)
        if linha_alfabeto < 7 and mid$(caractere_alfabeto$, linha_alfabeto * 9 + 9, 1) <> " " then error 5
        padrao_alfabeto = val("&b" + bits_alfabeto$)
        if right$("00000000" + bin$(padrao_alfabeto), 8) <> bits_alfabeto$ then error 5
        vpoke base(7) + codigo_alfabeto * 8 + linha_alfabeto, padrao_alfabeto
    next linha_alfabeto
next codigo_alfabeto
bsave "ALFABETO.BIN", base(7), base(7) + &h7ff, s
print "SALVO ALFABETO.BIN"
end

